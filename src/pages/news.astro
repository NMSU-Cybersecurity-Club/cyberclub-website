---
import Layout from '../layouts/base.astro'
import { formatNewsDate, getAllNewsItems } from '../lib/news'

const posts = await getAllNewsItems()
---
<Layout title="News & Writeups">
  <main id="main" class="page">
    <header class="page-heading"><h1>News &amp; Writeups</h1><p class="lede">Club updates, competition stories, and technical writeups.</p></header>
    {posts.length > 0 ? (
      <section class="news-list" aria-label="News and writeups">
        {posts.map((post) => (
          <article class="news-item">
            {(post.date || post.author) && (
              <p class="news-meta">
                {post.date && <time datetime={post.date.toISOString()}>{formatNewsDate(post.date)}</time>}
                {post.date && post.author && ' · '}
                {post.author}
              </p>
            )}
            <h2><a href={post.href}>{post.title}</a></h2>
            {post.description && <p>{post.description}</p>}
          </article>
        ))}
      </section>
    ) : (
      <section class="notice">
        <h2>No posts yet</h2>
        <p>Club news and writeups will appear here as they become available.</p>
      </section>
    )}
  </main>
</Layout>
