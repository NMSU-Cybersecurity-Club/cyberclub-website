<script>
  const COLLAPSE_LINE_THRESHOLD = 12;
  const CALLOUT_RE = /^\[!([a-zA-Z0-9_-]+)\]([+-])?(?:[ \t]+(.*))?$/;

  function initCallouts() {
    for (const bq of document.querySelectorAll(".docs-content blockquote")) {
      const firstP = bq.firstElementChild;
      if (!firstP || firstP.tagName !== "P") continue;

      const titleNodes: Node[] = [];
      const restNodes: Node[] = [];
      let foundBreak = false;

      for (const node of Array.from(firstP.childNodes)) {
        if (foundBreak) {
          restNodes.push(node);
          continue;
        }
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent ?? "";
          const nl = text.indexOf("\n");
          if (nl !== -1) {
            const before = text.slice(0, nl);
            const after = text.slice(nl + 1);
            if (before) titleNodes.push(document.createTextNode(before));
            if (after) restNodes.push(document.createTextNode(after));
            foundBreak = true;
          } else {
            titleNodes.push(node);
          }
        } else if (node instanceof HTMLBRElement) {
          foundBreak = true;
        } else {
          titleNodes.push(node);
        }
      }

      if (titleNodes.length === 0 || titleNodes[0].nodeType !== Node.TEXT_NODE) continue;
      const match = (titleNodes[0].textContent ?? "").match(CALLOUT_RE);
      if (!match) continue;

      const type = match[1].toLowerCase();
      const fold = match[2] || null;
      const isFoldable = fold === "+" || fold === "-";
      const firstTitleText = (match[3] ?? "").trimStart();

      const callout = document.createElement(isFoldable ? "details" : "div");
      callout.className = "callout";
      callout.setAttribute("data-callout", type);
      if (fold === "+" && callout instanceof HTMLDetailsElement) {
        callout.open = true;
      }

      const titleEl = document.createElement(isFoldable ? "summary" : "div");
      titleEl.className = "callout-title";

      const iconEl = document.createElement("span");
      iconEl.className = "callout-icon";
      iconEl.setAttribute("aria-hidden", "true");

      const titleTextEl = document.createElement("span");
      titleTextEl.className = "callout-title-text";
      if (firstTitleText) {
        titleTextEl.appendChild(document.createTextNode(firstTitleText));
      }
      for (let i = 1; i < titleNodes.length; i++) {
        titleTextEl.appendChild(titleNodes[i]);
      }
      if (!titleTextEl.hasChildNodes()) {
        titleTextEl.textContent = type.charAt(0).toUpperCase() + type.slice(1);
      }

      titleEl.append(iconEl, titleTextEl);
      if (isFoldable) {
        const foldEl = document.createElement("span");
        foldEl.className = "callout-fold";
        foldEl.setAttribute("aria-hidden", "true");
        titleEl.appendChild(foldEl);
      }

      const contentEl = document.createElement("div");
      contentEl.className = "callout-content";

      if (restNodes.some((n) => n.nodeType !== Node.TEXT_NODE || (n.textContent ?? "").trim() !== "")) {
        const newP = document.createElement("p");
        for (const n of restNodes) newP.appendChild(n);
        contentEl.appendChild(newP);
      }

      let sibling = firstP.nextSibling;
      while (sibling) {
        const next = sibling.nextSibling;
        contentEl.appendChild(sibling);
        sibling = next;
      }

      callout.append(titleEl, contentEl);
      bq.replaceWith(callout);
    }
  }

  function initDocs() {
    initCallouts();

    for (const pre of document.querySelectorAll(".docs-content pre")) {
      if (!(pre instanceof HTMLPreElement) || pre.querySelector(".code-copy-btn")) continue;

      const lang = pre.getAttribute("data-language");
      const defaultLabel = lang && lang !== "plaintext" ? lang : "copy";

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "code-copy-btn";
      btn.setAttribute("aria-label", `Copy ${defaultLabel} code`);

      const label = document.createElement("span");
      label.className = "code-copy-label";
      label.textContent = defaultLabel;

      const icon = document.createElement("span");
      icon.className = "code-copy-icon";
      icon.setAttribute("aria-hidden", "true");

      btn.append(label, icon);
      pre.appendChild(btn);

      let resetTimer = 0;
      btn.addEventListener("click", async () => {
        const lines = pre.querySelectorAll("code .line");
        const code = pre.querySelector("code");
        const text =
          lines.length > 0
            ? Array.from(lines, (line) => line.textContent ?? "").join("\n")
            : (code ? code.innerText : pre.innerText).replace(/\n$/, "");

        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          label.textContent = "Copied!";
          clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            btn.classList.remove("copied");
            label.textContent = defaultLabel;
          }, 1600);
        } catch {
          label.textContent = "Failed";
          clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            label.textContent = defaultLabel;
          }, 1600);
        }
      });

      const lineCount = pre.querySelectorAll("code .line").length;
      if (lineCount > COLLAPSE_LINE_THRESHOLD) {
        const wrapper = document.createElement("div");
        wrapper.className = "code-block is-collapsed";
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const expandBtn = document.createElement("button");
        expandBtn.type = "button";
        expandBtn.className = "code-expand-btn";
        expandBtn.setAttribute("aria-expanded", "false");

        const expandText = document.createElement("span");
        expandText.textContent = `Show more (${lineCount} lines)`;

        const chevron = document.createElement("span");
        chevron.className = "code-expand-chevron";
        chevron.setAttribute("aria-hidden", "true");

        expandBtn.append(expandText, chevron);
        wrapper.appendChild(expandBtn);

        expandBtn.addEventListener("click", () => {
          const isCurrentlyCollapsed = wrapper.classList.contains("is-collapsed");

          if (isCurrentlyCollapsed) {
            pre.style.maxHeight = `${pre.offsetHeight}px`;
            wrapper.classList.remove("is-collapsed");
            wrapper.classList.add("is-expanded");
            const targetHeight = pre.scrollHeight;
            requestAnimationFrame(() => {
              pre.style.maxHeight = `${targetHeight}px`;
            });
            expandBtn.setAttribute("aria-expanded", "true");
            expandText.textContent = "Show less";
          } else {
            pre.style.maxHeight = `${pre.scrollHeight}px`;
            void pre.offsetHeight;
            wrapper.classList.remove("is-expanded");
            wrapper.classList.add("is-collapsed");
            pre.style.maxHeight = "";
            expandBtn.setAttribute("aria-expanded", "false");
            expandText.textContent = `Show more (${lineCount} lines)`;
          }
        });

        pre.addEventListener("transitionend", (event) => {
          if (
            event.propertyName === "max-height" &&
            wrapper.classList.contains("is-expanded")
          ) {
            pre.style.maxHeight = "";
          }
        });
      }
    }

    function initAnimatedDetails(
      detailsSelector: string,
      summarySelector: string,
      contentSelector: string,
      initKey: string,
    ) {
      for (const details of document.querySelectorAll(detailsSelector)) {
        if (!(details instanceof HTMLDetailsElement)) continue;
        if (details.dataset[initKey]) continue;
        details.dataset[initKey] = "true";
        const summary = details.querySelector(summarySelector);
        const content = details.querySelector(contentSelector);
        if (!(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) continue;

        summary.addEventListener("click", (event) => {
          event.preventDefault();

          if (!details.open || details.classList.contains("is-closing")) {
            details.classList.remove("is-closing");
            content.style.height = "0px";
            content.style.opacity = "0";
            content.style.marginTop = "0px";
            details.open = true;

            const targetHeight = content.scrollHeight;
            requestAnimationFrame(() => {
              content.style.height = `${targetHeight}px`;
              content.style.opacity = "1";
              content.style.marginTop = "";
            });
          } else {
            content.style.height = `${content.offsetHeight}px`;
            content.style.opacity = "1";
            void content.offsetHeight;
            details.classList.add("is-closing");
            content.style.height = "0px";
            content.style.opacity = "0";
            content.style.marginTop = "0px";
          }
        });

        content.addEventListener("transitionend", (event) => {
          if (event.target !== content || event.propertyName !== "height") return;

          if (details.classList.contains("is-closing")) {
            details.open = false;
            details.classList.remove("is-closing");
          }
          content.style.height = "";
          content.style.opacity = "";
          content.style.marginTop = "";
        });
      }
    }

    initAnimatedDetails(
      "details.callout",
      ":scope > summary.callout-title",
      ":scope > .callout-content",
      "calloutInit",
    );

    initAnimatedDetails(
      "details.ft-folder",
      ":scope > summary.ft-row",
      ":scope > .ft-children",
      "folderInit",
    );
  }

  initDocs();
  document.addEventListener("astro:page-load", initDocs);
</script>
